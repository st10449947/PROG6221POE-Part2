<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CybersecurityChatbot"
        mc:Ignorable="d"
        Title="CybersecurityBot"
        Height="567"
        Width="800"
        Background="Black">

    <Grid>

        <!-- ROWS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Background="#111B21">

            <TextBlock Text="Cybersecurity Chatbot"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

            <!-- PROFILE IMAGE (FIXED) -->
            <Border Width="45"
                    Height="45"
                    CornerRadius="22.5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,15,0"
                    BorderBrush="#25D366"
                    BorderThickness="2">

                <Image Source="pack://application:,,,/Images/Profile.jpeg"
                       Stretch="UniformToFill"/>
            </Border>

        </Grid>

        <!-- ASCII AREA -->
        <Border Grid.Row="1"
                Background="Black"
                Padding="5">

            <TextBlock FontFamily="Consolas"
                       FontSize="9"
                       Foreground="#25D366"
                       HorizontalAlignment="Center"
                       TextAlignment="Left"
                       xml:space="preserve">

  ____      _                                        _ _              
 / ___|   _| |__   ___ _ __ ___  ___  ___ _   _ _ __(_) |_ _   _      
| |  | | | | '_ \ / _ \ '__/ __|/ _ \/ __| | | | '__| | __| | | |     
| |__| |_| | |_) |  __/ |  \__ \  __/ (__| |_| | |  | | |_| |_| |     
 \____\__, |_.__/ \___|_|  |___/\___|\___|\__,_|_|  |_|\__|\__, |      
      |___/                                                 |___/

            </TextBlock>

        </Border>

        <!-- CHAT AREA -->
        <Border Grid.Row="2"
                Background="Black"
                Margin="5"
                CornerRadius="10">

            <ScrollViewer x:Name="ChatScroller"
                          VerticalScrollBarVisibility="Auto"
                          Background="Black">

                <StackPanel x:Name="ChatPanel"
                            Margin="10"/>

            </ScrollViewer>

        </Border>

        <!-- INPUT AREA -->
        <Grid Grid.Row="3"
              Background="#111B21"
              Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>

            <!-- INPUT -->
            <Border Grid.Column="0"
                    Background="#202C33"
                    CornerRadius="20"
                    Margin="0,0,10,0">

                <TextBox x:Name="UserInput"
                         Background="Transparent"
                         Foreground="White"
                         CaretBrush="White"
                         BorderThickness="0"
                         Padding="15"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         KeyDown="UserInput_KeyDown"/>
            </Border>

            <!-- SEND BUTTON -->
            <Button Grid.Column="1"
                    Content="Send"
                    Background="#25D366"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SendButton_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>

        </Grid>

    </Grid>
</Window>


